SHELL        = /bin/sh
CD           = cd
CP           = cp
LN_S         = ln -s
MKDIR        = mkdir -p
RM           = rm -f
TOUCH        = touch

ARCH         = Linux_npbench

TOPdir       = /home/alex/Studium/bachelor_thesis/np_bench_fork/npbench/npbench/hardware_info/practical/linpack_hpl-2.3
INCdir       = $(TOPdir)/include
BINdir       = $(TOPdir)/bin/$(ARCH)
LIBdir       = $(TOPdir)/lib/$(ARCH)

HPLlib       = $(LIBdir)/libhpl.a

# MPI
MPdir        =
MPinc        = -I/usr/lib/x86_64-linux-gnu/openmpi/include -I/usr/lib/x86_64-linux-gnu/openmpi/include/openmpi
MPlib        = -L/usr/lib/x86_64-linux-gnu/openmpi/lib -lmpi

# BLAS
LAdir        =
LAinc        = -I/usr/include/x86_64-linux-gnu/openblas-pthread/
LAlib        = -L/usr/lib/x86_64-linux-gnu/openblas-pthread/ -lopenblas

# Fortran/C interface
F2CDEFS      = -DAdd_ -DF77_INTEGER=int -DStringSunStyle

# HPL includes / libs
HPL_INCLUDES = -I$(INCdir) -I$(INCdir)/$(ARCH) $(LAinc) $(MPinc)
HPL_LIBS     = $(HPLlib) $(LAlib) $(MPlib)

HPL_OPTS     =
HPL_DEFS     = $(F2CDEFS) $(HPL_OPTS) $(HPL_INCLUDES)

# Compilers
CC           = mpicc
CCNOOPT      = $(HPL_DEFS)
CCFLAGS      = $(HPL_DEFS) -O3 -march=native -fopenmp

LINKER       = mpicc
LINKFLAGS    = $(HPL_DEFS) -O3 -march=native

ARCHIVER     = ar
ARFLAGS      = r
RANLIB       = ranlib
